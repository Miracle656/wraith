# ─── Database ───────────────────────────────────────────────
# Critical for mainnet: Use a durable external provider (e.g. Neon, Supabase).
# Do NOT use Render free Postgres as it is deleted after 90 days.
# See docs/DEPLOY_MAINNET.md for more details.
#
# Local:
#   DATABASE_URL="postgresql://wraith:wraith@localhost:5432/wraith"
#   DIRECT_DATABASE_URL="postgresql://wraith:wraith@localhost:5432/wraith"
# Both database URLs are required at startup. All other values below are
# optional unless a comment describes a conditional requirement.
#
# Supabase (pooler for queries, direct for migrations):
#   DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
#   DIRECT_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://wraith:wraith@localhost:5432/wraith"
DIRECT_DATABASE_URL="postgresql://wraith:wraith@localhost:5432/wraith"

# ─── Network ─────────────────────────────────────────────────
# Set STELLAR_NETWORK to "testnet" or "mainnet".
#   testnet → SOROBAN_RPC_URL defaults to https://soroban-testnet.stellar.org
#   mainnet → SOROBAN_RPC_URL is required (no free public mainnet RPC)
STELLAR_NETWORK="testnet"

# ─── Soroban RPC ─────────────────────────────────────────────
# Explicit RPC endpoint — overrides any network-based default.
# Required when STELLAR_NETWORK=mainnet.
# Backward-compat: STELLAR_RPC_URL is also accepted if SOROBAN_RPC_URL is unset.
#
# Testnet (public, free):
#   SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
#
# Mainnet providers (choose one):
#   Validation Cloud: https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
#   Ankr:             https://rpc.ankr.com/stellar_soroban/<API_KEY>
#   Self-hosted:      https://your-own-rpc.example.com
#
# Leave blank when STELLAR_NETWORK=testnet to use the default testnet URL.
SOROBAN_RPC_URL=

# ─── Indexer config ──────────────────────────────────────────
# Ledger to start indexing from (leave blank to resume from DB state)
START_LEDGER=

# Polling interval in ms (default: 6000 = ~1 ledger)
POLL_INTERVAL_MS=6000

# Optional candles read API and OHLC refresh worker. Disabled when unset or 0.
# Enable only after usable single-network OHLC tables/functions are installed.
# Use an integer interval in ms (1..2147483647), for example 60000.
# Invalid values or SKIP_INDEXER=true disable both; NETWORKS must contain only
# STELLAR_NETWORK. Generate OpenAPI with these same deployment settings.
OHLC_REFRESH_INTERVAL_MS=0

# ─── SAC Contract IDs ────────────────────────────────────────
# Comma-separated list of Soroban SAC (Stellar Asset Contract) IDs to watch.
# When unset, defaults to the native XLM SAC for the configured STELLAR_NETWORK:
#   testnet  → CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
#   mainnet  → CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
#
# How to derive a SAC address for any Stellar asset:
#   import { Asset, Networks } from '@stellar/stellar-sdk';
#   // Native XLM:
#   Asset.native().contractId(Networks.PUBLIC);
#   // Custom asset (e.g., USDC issued by Centre):
#   new Asset('USDC', 'GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN')
#     .contractId(Networks.PUBLIC);
#
# Known mainnet SAC addresses:
#   XLM (native): CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
#   USDC (Centre): CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
#
# Example (watch XLM + USDC on mainnet):
#   SAC_CONTRACT_IDS=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA,CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
#
# Per-network watch lists (for dual-network deployments when NETWORKS=testnet,mainnet):
#   SAC_CONTRACT_IDS_TESTNET=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
#   SAC_CONTRACT_IDS_MAINNET=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
#
# Soroban RPC's getEvents accepts multiple contract IDs in a single request —
# there is no N+1 query penalty for watching multiple contracts.
SAC_CONTRACT_IDS=
SAC_CONTRACT_IDS_TESTNET=
SAC_CONTRACT_IDS_MAINNET=

# ─── NFT Contract IDs ───────────────────────────────────────────────────────
# Comma-separated list of CAP-46 NFT contract IDs to explicitly watch.
# When unset, NFT events are still auto-detected from any contract event that
# carries 4 topics (the CAP-46 transfer(from, to, token_id) structure).
#
# Example (watch a known testnet NFT contract):
#   NFT_CONTRACT_IDS=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
#
# Per-network NFT watch lists (for dual-network deployments):
#   NFT_CONTRACT_IDS_TESTNET=
#   NFT_CONTRACT_IDS_MAINNET=

# NFT metadata enrichment is bounded so it can never stall ingest.
# Concurrent metadata lookups per poll cycle (default 8), and the total time
# in ms a cycle may spend on them (default 10000). Tokens not finished within
# the budget stay uncached and are retried on a later cycle.
# NFT_METADATA_CONCURRENCY=8
# NFT_METADATA_BUDGET_MS=10000
NFT_CONTRACT_IDS=
NFT_CONTRACT_IDS_TESTNET=
NFT_CONTRACT_IDS_MAINNET=

# Legacy alias — CONTRACT_IDS is still accepted for backwards-compatibility.
# SAC_CONTRACT_IDS takes precedence when both are set.
# CONTRACT_IDS=

# Max events per RPC call (Stellar RPC hard-caps at 10000)
EVENTS_BATCH_SIZE=10000

# Shard each poll window across N workers (by contract) for throughput. This
# changes how fast a window is ingested, never what is indexed: both paths run
# every record through the same pipeline (transfers, NFTs and their metadata,
# LP shares, host-fn logs, account summaries). Default 1 = no sharding.
# INGEST_WORKERS=1

# Delete transfers older than N days to stay within DB free-tier limits (default: 30)
RETENTION_DAYS=30

# ─── API ─────────────────────────────────────────────────────
PORT=3000

# ─── CORS ─────────────────────────────────────────────────────
# Which browser origins may call the surfaces that are not public.
# Comma-separated; matched exactly, after normalisation. A new client is a
# change to this line, not to the source.
#
# Open to every origin (deliberately, and documented in src/middleware/cors.ts):
# the public read API, GraphQL, the fee quote, the offramp quotes.
#
# Restricted to the list below: the offramp orders, the naira rails, webhook
# subscription management, /metrics, and any write nobody has classified yet.
# A request from an origin that is not on this list is refused with 403 and
# the code `origin_not_allowed`.
#
# Empty means no browser origin may call those surfaces. The mobile app sends
# no Origin header at all and is unaffected either way; a browser client (the
# web wallet) has to be listed here before it can reach them.
CORS_ALLOWED_ORIGINS=

# ─── Response cache (Redis) ──────────────────────────────────
# Opt-in caching for the hot read endpoints (/assets/popular, /search).
# Off by default; set CACHE_ENABLED=true to turn it on.
# Clients can force a fresh response with the `X-No-Cache` request header.
CACHE_ENABLED=false
REDIS_URL="redis://localhost:6379"
# Key namespace applied to every cached entry.
CACHE_KEY_PREFIX="wraith:cache:"
# Per-route TTLs in milliseconds.
CACHE_TTL_POPULAR_MS=60000
CACHE_TTL_SEARCH_MS=15000

# ─── Contract tombstones ────────────────────────────────────────────────────
# How many poll cycles between contract-liveness checks (#137). Each check
# costs one RPC call per unique watched contract, so this is deliberately far
# rarer than a poll: a contract TTL is measured in weeks, and noticing an
# expiry ten minutes late costs nothing. Set to 0 to disable the check.
# Default: 100 cycles (~10 min at the default 6s poll interval).
TOMBSTONE_CHECK_EVERY_CYCLES=100

# ─── LP-share tracking ──────────────────────────────────────────────────────
# Contracts to treat as liquidity pools even before one of their explicit
# deposit/withdraw events has been observed (#136).
#
# Bare SEP-41 mint/burn is only recorded as an LP-share movement for contracts
# already established as pools — otherwise every stablecoin mint on the chain
# would land in LpShareTransfer as a liquidity deposit. A pool normally
# identifies itself by emitting deposit/withdraw; list one here only if it
# emits nothing but bare mint/burn.
LP_POOL_CONTRACT_IDS=
LP_POOL_CONTRACT_IDS_TESTNET=
LP_POOL_CONTRACT_IDS_MAINNET=

# Start the API without the indexer loop. Used by the integration harness so
# HTTP tests run against a seeded database without an ingest racing them, and
# without needing live RPC. Not for production.
SKIP_INDEXER=false

# ─── NGN rate limiting (naira rails creating routes) ─────────────────────────
# Per-IP limits catch one caller making many requests with different references.
# Per-reference limits catch one reference being hammered from different IPs.
# All configurable without a deploy; defaults are conservative.
#
# Provisioning: POST /ngn/customers
#   NGN_PROVISION_WINDOW_MS=600000        # 10 min
#   NGN_PROVISION_MAX=10                   # 10 per IP per window
#   NGN_PROVISION_REF_WINDOW_MS=600000    # 10 min
#   NGN_PROVISION_REF_MAX=3               # 3 per reference per window
#
# KYC: POST /ngn/customers/kyc
#   NGN_KYC_WINDOW_MS=1800000             # 30 min
#   NGN_KYC_MAX=5                          # 5 per IP per window
#   NGN_KYC_REF_WINDOW_MS=1800000         # 30 min
#   NGN_KYC_REF_MAX=2                      # 2 per reference per window
#
# Orders: POST /ngn/onramp/orders, POST /ngn/bills
#   NGN_ORDERS_WINDOW_MS=900000           # 15 min
#   NGN_ORDERS_MAX=20                      # 20 per IP per window
#   NGN_ORDERS_REF_WINDOW_MS=900000       # 15 min
#   NGN_ORDERS_REF_MAX=5                  # 5 per reference per window
# ─── Additional runtime settings ────────────────────────────────────────────
# Every value in this section is optional. Empty values are placeholders only.

# Prisma read replicas (comma-separated connection URLs).
DATABASE_REPLICAS= # Optional; URLs for additional read-only database replicas.
# Use "development", "test", or "production" to control Prisma logging and caching.
NODE_ENV= # Optional; runtime environment name.

# Indexer network selection; NETWORKS overrides the single STELLAR_NETWORK default.
NETWORKS= # Optional; comma-separated networks to index (testnet,mainnet).
# Optional per-network RPC overrides and legacy alias for STELLAR_RPC_URL.
SOROBAN_RPC_URL_TESTNET= # Optional; testnet Soroban RPC endpoint.
SOROBAN_RPC_URL_MAINNET= # Required when indexing mainnet, unless a legacy RPC alias is used.
STELLAR_RPC_URL= # Optional; legacy RPC endpoint for a single-network deployment.
STELLAR_RPC_URL_TESTNET= # Optional; legacy testnet RPC endpoint.
STELLAR_RPC_URL_MAINNET= # Required when indexing mainnet unless another mainnet RPC URL is set.
# Optional Horizon endpoints and event path for indexing / price lookup.
HORIZON_URL= # Optional; legacy Horizon endpoint.
HORIZON_URL_TESTNET= # Optional; testnet Horizon endpoint.
HORIZON_URL_MAINNET= # Optional; mainnet Horizon endpoint and price lookup source.
HORIZON_EVENTS_PATH= # Optional; Horizon events API path.
# Optional per-network start ledger overrides; blank resumes from database state.
START_LEDGER_TESTNET= # Optional; testnet ledger to start from.
START_LEDGER_MAINNET= # Optional; mainnet ledger to start from.

# Optional rate limits (defaults: 60 seconds and 60 requests).
RATE_LIMIT_WINDOW_MS=60000 # Optional; rate-limit window in milliseconds.
RATE_LIMIT_MAX=60 # Optional; requests allowed per IP in each window.
# Optional maximum number of rows returned by transfer exports (default: 50000).
EXPORT_MAX_ROWS=50000 # Optional; maximum rows per export.
# Optional interval between partition-retention runs (default: six hours).
PARTITION_RETENTION_INTERVAL_MS=21600000 # Optional; retention job interval in milliseconds.
# Optional persisted GraphQL query file path and query complexity limits.
PERSISTED_QUERIES_PATH= # Optional; persisted GraphQL query file.
GRAPHQL_MAX_DEPTH=10 # Optional; GraphQL query depth limit.
GRAPHQL_MAX_COST=1000 # Optional; GraphQL query complexity limit.
# npm supplies this automatically when the service is launched by npm.
# npm_package_version=1.0.0

# Optional OPA authorization settings (defaults to localhost:8181 and wraith/authz).
OPA_URL=http://localhost:8181 # Optional; Open Policy Agent URL.
OPA_POLICY=wraith/authz # Optional; OPA policy path.
# Optional mainnet CoinGecko/Horizon price lookup endpoint.
# HORIZON_URL_MAINNET is also used by the indexer; leave blank to use its code default.

# Optional LINQ integration. Keep actual credentials in deployment secrets, never here.
LINQ_API_KEY= # Optional; secret API key for LINQ integrations.
LINQ_BASE_URL= # Optional; LINQ API base URL.
LINQ_WEBHOOK_SECRET= # Optional; secret used to verify LINQ webhook requests.
OFFRAMP_LOOKUP_WINDOW_MS=900000 # Optional; off-ramp lookup rate-limit window.
OFFRAMP_LOOKUP_MAX_FAILURES=10 # Optional; failed lookups allowed per window.

# Optional platform fee configuration. Fees are disabled unless a valid destination
# and asset configuration are supplied.
VEIL_FEE_DESTINATION= # Optional; fee recipient account (required to enable fees).
VEIL_FEE_PERCENT= # Optional; fee rate percentage.
VEIL_FEE_AMOUNT= # Optional; flat fee for the configured issued asset.
VEIL_FEE_MIN= # Optional; minimum fee for the configured issued asset.
VEIL_FEE_MAX= # Optional; maximum fee for the configured issued asset.
VEIL_FEE_ASSET_CODE=USDC # Optional; issued asset code (default: USDC).
VEIL_FEE_ASSET_ISSUER= # Optional; issued asset issuer account.
VEIL_FEE_AMOUNT_XLM= # Optional; flat fee in native XLM.
VEIL_FEE_MIN_XLM= # Optional; minimum fee in native XLM.
VEIL_FEE_MAX_XLM= # Optional; maximum fee in native XLM.
